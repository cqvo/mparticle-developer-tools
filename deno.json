{
  "tasks": {
    "test": "deno test -A",
    "e2e": "deno task build && deno test -A e2e/mparticle.e2e.ts",
    "check": "deno check src test e2e",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "build": "deno bundle --platform browser --outdir dist src/panel.ts src/devtools.ts && cp src/manifest.json src/panel.html src/devtools.html dist/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "types": ["npm:@types/chrome@^0.1"]
  },
  "imports": {
    "jsdom": "npm:jsdom@^30",
    "@std/testing": "jsr:@std/testing@^1",
    "@deno/emit": "jsr:@deno/emit@^0.46",
    "puppeteer": "npm:puppeteer-core@^24"
  },
  "fmt": { "singleQuote": true, "lineWidth": 120, "exclude": ["**/*.html"] },
  "exclude": ["dist"]
}
